# Arduino 编译缓存 / 中间产物
build/
build_cache/
*.o
*.elf
*.map
*.d

# VS Code（保留公共配置）
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# 操作系统
Thumbs.db
.DS_Store

# 密钥（WiFi 密码、WxPusher token 等，禁止提交）
secrets.h
*_secrets.h

# 算法数据集（体积大，组员各自下载）
algo/data/
algo/reference/

# Python 缓存
__pycache__/
*.pyc

# 宿主回放构建产物（g++ 编出的 .exe 与临时拷贝的源码）
algo/cnn/host_replay/.build/
