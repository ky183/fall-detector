#pragma once
// ============================================================
//  凭据模板 — 使用方法：
//    1. 复制本文件，重命名为 secrets.h（同目录）
//    2. 填入真实值
//    3. secrets.h 已被 .gitignore 忽略，永远不会被提交
//       （泄露 WiFi 密码/Token 到 GitHub 是严重事故，勿提交）
//    4. 请用 Arduino IDE / VS Code 编辑保存（UTF-8 编码，
//       不要用记事本另存，否则中文可能变乱码）
// ============================================================

// ---- WiFi（腰端推送时连接）----
// 注意：必须是普通密码的 WiFi（家用路由器/手机热点），校园网企业认证不支持
// 必须是 2.4GHz 频段（5G 热点连不上；iPhone 开"最大化兼容性"）
#define WIFI_SSID          "你的WiFi名"
#define WIFI_PASS          "你的WiFi密码"

// ---- WxPusher（微信推送服务，注册：https://wxpusher.zjiecode.com）----
// 创建应用后得到的 appToken（AT_ 开头）
#define WXPUSHER_APP_TOKEN "AT_xxxx"

// 收推送的 UID 列表：每个人扫码关注应用后都有自己的 UID，
// 想让几个人收就在这里填几个（用英文逗号分隔，别删引号）
#define WXPUSHER_UIDS      "UID_组员1", "UID_组员2", "UID_家属"
